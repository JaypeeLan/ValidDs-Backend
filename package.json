{
  "name": "validds-backend",
  "version": "1.0.0",
  "description": "ValidDs backend — TikTok product research and validation platform for dropshippers",
  "main": "dist/server.js",
  "author": "Supreme Ecom",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Valid-Ds/ValidDs-Backend.git"
  },
  "bugs": {
    "url": "https://github.com/Valid-Ds/ValidDs-Backend/issues"
  },
  "homepage": "https://github.com/Valid-Ds/ValidDs-Backend#readme",
  "keywords": [
    "tiktok",
    "product-research",
    "dropshipping",
    "ecommerce",
    "scraper",
    "backend",
    "api",
    "express",
    "mongodb",
    "redis"
  ],
  "engines": {
    "node": ">=20.0.0 <26",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "swc src -d dist --strip-leading-paths && rm -rf dist/docs/openapi && mkdir -p dist/docs && cp -R src/docs/openapi dist/docs/openapi && node scripts/validate-openapi.js",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/server.js",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests scripts --ext .ts",
    "lint:fix": "eslint src tests scripts --ext .ts --fix",
    "generate-api-key": "ts-node scripts/generate-api-key.ts",
    "make-admin": "ts-node src/scripts/make-admin.ts",
    "dedupe-creatives": "node scripts/dedupe-creatives.cjs",
    "cache-creator-avatars": "ts-node --transpile-only scripts/cache-creator-avatars.ts",
    "cache-shop-avatars": "ts-node --transpile-only scripts/cache-shop-avatars.ts",
    "tester:ui": "node tools/backend-tester/server.js",
    "frontend:react": "node tools/full-frontend/server.js",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^7.99.0",
    "apify-client": "^2.23.2",
    "axios": "^1.6.7",
    "bullmq": "^5.1.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^8.1.1",
    "node-fetch": "^2.7.0",
    "socket.io": "^4.8.3",
    "stripe": "^16.12.0",
    "swagger-parser": "^10.0.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "yamljs": "^0.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/mongo-sanitize": "^1.0.3",
    "@types/node": "^20.11.5",
    "@types/socket.io": "^3.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "docx": "^9.6.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.6",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs,json,yml,yaml,md}": "prettier --write",
    "{src,tests,scripts}/**/*.ts": "eslint --fix"
  }
}

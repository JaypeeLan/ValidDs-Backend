# ============================================================
# ValidDs Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# See docs/third-party/ for setup guides per service.
# ============================================================

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
NODE_ENV=development           # development | staging | production
PORT=3000
APP_NAME=validds-backend
API_VERSION=v1

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
# Generate with: npm run generate-api-key
INTERNAL_API_KEY=

# JWT (used for future auth layer)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AES-256 encryption key for sensitive stored fields (32 bytes hex)
ENCRYPTION_KEY=

# Allowed CORS origins (comma-separated)
# e.g. https://app.validds.com,https://staging.validds.com
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ------------------------------------------------------------
# MONGODB ATLAS
# See docs/third-party/mongodb-atlas.md
# ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=validds

# ------------------------------------------------------------
# UPSTASH REDIS
# See docs/third-party/upstash-redis.md
# ------------------------------------------------------------
REDIS_URL=rediss://<password>@<endpoint>.upstash.io:6379
# OR split form if needed:
REDIS_HOST=redis://localhost:6379
REDIS_PORT=127.0.0.1
REDIS_PASSWORD=
REDIS_TLS=true

# ------------------------------------------------------------
# SENTRY
# See docs/third-party/sentry.md
# ------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development    # development | staging | production
SENTRY_TRACES_SAMPLE_RATE=0.1    # 0.0 to 1.0

# ------------------------------------------------------------
# TIKTOK DATA ACQUISITION
# See docs/data-acquisition.md
# ------------------------------------------------------------
TIKTOK_API_KEY=
TIKTOK_API_BASE_URL=

# Creative Center ingestion config
TIKTOK_REGION=US


# ------------------------------------------------------------
# TIKTOK LOGIN (OAUTH)
# Needed for: POST /api/v1/auth/tiktok
# ------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ------------------------------------------------------------
# RESEND (EMAIL)
# Needed for: verification codes + forgot password emails
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=debug                  # trace | debug | info | warn | error | fatal
LOG_PRETTY=true                  # true in dev, false in production (JSON output)

# ------------------------------------------------------------
# PROMETHEUS
# See docs/third-party/prometheus.md
# ------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090                # Separate port for /metrics scraping

# ------------------------------------------------------------
# GOOGLE OAUTH
# See docs/third-party/google-oauth.md
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full URL to your callback route — must match what's registered in Google Console
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/api/v1/auth/google/callback
# Frontend URL — where to redirect after successful OAuth
FRONTEND_URL=http://localhost:3001

DEEPSEEK_API_KEY=
ENSEMBLE_API_KEY=
GOOGLE_API_KEY=
RAINFOREST_API_KEY=

# ============================================================
# ValidDs Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# See docs/third-party/ for setup guides per service.
# ============================================================

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
NODE_ENV=development           # development | staging | production
PORT=3000
APP_NAME=validds-backend
API_VERSION=v1

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
# Generate with: npm run generate-api-key
INTERNAL_API_KEY=

# Python scraper → POST /internal/ingest/* (header X-Ingest-Key; must match scraper SCRAPER_INGEST_KEY)
SCRAPER_INGEST_KEY=change-me-scraper-ingest-key

# JWT (used for future auth layer)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AES-256 encryption key for sensitive stored fields (32 bytes hex)
ENCRYPTION_KEY=

# Allowed CORS origins (comma-separated)
# e.g. https://app.validds.com,https://staging.validds.com
CORS_ALLOWED_ORIGINS=http://localhost:3001,https://valid-ds-frontend.vercel.app

# ------------------------------------------------------------
# MONGODB ATLAS
# See docs/third-party/mongodb-atlas.md
# ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=validds

# ------------------------------------------------------------
# UPSTASH REDIS
# See docs/third-party/upstash-redis.md
# ------------------------------------------------------------
REDIS_URL=rediss://<password>@<endpoint>.upstash.io:6379
# OR split form if needed:
REDIS_HOST=redis://localhost:6379
REDIS_PORT=127.0.0.1
REDIS_PASSWORD=
REDIS_TLS=true

# ------------------------------------------------------------
# SENTRY
# See docs/third-party/sentry.md
# ------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development    # development | staging | production
SENTRY_TRACES_SAMPLE_RATE=0.1    # 0.0 to 1.0

# ------------------------------------------------------------
# TIKTOK DATA ACQUISITION
# See docs/data-acquisition.md
# ------------------------------------------------------------
TIKTOK_API_KEY=
TIKTOK_API_BASE_URL=

# Creative Center ingestion config
TIKTOK_REGION=US


# ------------------------------------------------------------
# TIKTOK LOGIN (OAUTH)
# Needed for: POST /api/v1/auth/tiktok
# ------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ------------------------------------------------------------
# RESEND (EMAIL)
# Needed for: verification codes + forgot password emails
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=debug                  # trace | debug | info | warn | error | fatal
LOG_PRETTY=true                  # true in dev, false in production (JSON output)
ENABLE_DEV_JOBS=false            # set true only when intentionally testing schedulers locally
ENABLE_BACKGROUND_JOBS=false     # POST /jobs/* triggers + job execution (required for cron)
ENABLE_IN_PROCESS_SCHEDULERS=   # omit/true = setInterval timers in API; false = external cron only (see docs/cron-jobs.md)
# External cron (this repo only): CRON_BACKEND_URL + render.yaml, or .github/workflows/backend-cron.yml
# Sales/revenue trends: scraper repo (bin/cron-metric-trends.sh). Live: live-scrapper (in-process).

# ------------------------------------------------------------
# GOOGLE OAUTH
# See docs/third-party/google-oauth.md
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full URL to your callback route — must match what's registered in Google Console
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/api/v1/auth/google/callback
# Frontend URL — OAuth return + default Stripe Checkout success/cancel redirects (see GET /api/v1/billing/plans)
# Production: set to your deployed SPA origin, e.g. https://app.example.com
# Production SPA (Shopify post-install forwards here from /shopify/connected)
FRONTEND_URL=http://localhost:3001

DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GOOGLE_AI_API_KEY=
TEEMDROP_APP_KEY=
TEEMDROP_APP_SECRET=
TEEMDROP_BASE_URL=https://openapi.teemdrop.com
TEEMDROP_USER_AGENT=PostmanRuntime/7.43.0

# ------------------------------------------------------------
# STRIPE
# - NODE_ENV=production → uses *_LIVE keys, *_TEST otherwise (see src/services/stripe.service.ts).
# - Render / VPS: set FRONTEND_URL, all price IDs for your mode, secret + publishable + webhook secret,
#   and in Stripe Dashboard add webhook endpoint: https://<API_HOST>/api/v1/webhooks/stripe
# - Publishable key: GET /api/v1/billing/stripe-config (for Stripe.js)
# - Plan UI + default redirect URLs: GET /api/v1/billing/plans
# Local CLI: stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
# ------------------------------------------------------------
STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=

# Stripe Price IDs — copy from Stripe Dashboard → Products
# All plans are recurring subscriptions; free trial is applied automatically (7 days).
# Test mode
STRIPE_PRICE_ID_EXPLORER_TEST=price_1TMEjiFYFVzQsP3l4Ec0kH6V
STRIPE_PRICE_ID_PRO_TEST=price_1TMEkaFYFVzQsP3lz9SitrGw
STRIPE_PRICE_ID_PREMIUM_TEST=price_1TMElIFYFVzQsP3lTUf1opXQ
# Live price IDs (fill in when going to production)
STRIPE_PRICE_ID_EXPLORER_LIVE=
STRIPE_PRICE_ID_PRO_LIVE=
STRIPE_PRICE_ID_PREMIUM_LIVE=
APIFY_API_TOKEN=
APIFY_SHOPIFY_MAX_ITEMS=

# ScrapeCreators — TikTok Live (https://app.scrapecreators.com)
SCRAPECREATORS_API_KEY=
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com

# Env files: `.env` and optional `backend.env` in this directory are both loaded
# (see `src/server.ts`). Use either; `backend.env` fills any keys missing from `.env`.

# ------------------------------------------------------------
# SHOPIFY OAUTH (Connect Shopify store)
# Required for: GET /api/v1/stores/shopify/install
#               GET /api/v1/stores/shopify/callback
#               POST /api/v1/stores/shopify/products
#
# Create a Shopify Partner account → Apps → Create app, then copy
# the Client ID / Client Secret here. The redirect URI must be
# whitelisted in your app settings and must match SHOPIFY_REDIRECT_URI
# below exactly.
#
# Scopes default to: write_products,read_products
# ------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_SCOPES=write_products,read_products
SHOPIFY_API_VERSION=2024-10
SHOPIFY_REDIRECT_URI=https://your-app.onrender.com/api/v1/stores/shopify/callback
# Partner Dashboard → App URL (install + automated review checks):
#   https://your-app.onrender.com/shopify/app
# Partner Dashboard → Webhooks (mandatory compliance + HMAC):
#   https://your-app.onrender.com/api/v1/webhooks/shopify
#   Topics: customers/data_request, customers/redact, shop/redact, app/uninstalled
# Shopify signup URL — use Impact affiliate link (pxf.io) for tracked attribution
# The referral code is appended as sub_id (Impact) or ref (standard shopify.com)
SHOPIFY_SIGNUP_URL=https://shopify.pxf.io/Jk253E
SHOPIFY_PARTNER_REFERRAL_CODE=validds

# ------------------------------------------------------------
# AWS S3 — Bright Data TikTok video delivery + playback proxy
# ------------------------------------------------------------
AWS_S3_BUCKET=
AWS_S3_VIDEO_PREFIX=brightdata/tiktok-videos
# Meta Ad Library MP4s (scraper `META_VIDEO_S3_PREFIX` — keys like `{prefix}/{adId}.mp4`)
META_VIDEO_S3_PREFIX=brightdata/tiktok-videos/meta
AWS_S3_IMAGE_PREFIX=validds/creator-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Legacy aliases also supported: Bucket_name, Access_Key_ID, Secret_Access_Key, S3_Endpoint

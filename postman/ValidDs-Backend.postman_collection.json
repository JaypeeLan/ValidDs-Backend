            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.success && res?.data?.token) {",
                  "  pm.environment.set('token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "response": [

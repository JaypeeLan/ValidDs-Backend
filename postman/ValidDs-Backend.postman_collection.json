            "description": "Creates a Stripe Checkout Session for the pro plan with a 7-day free trial. The user enters card details but is not charged until the trial ends.\n\nRedirect the browser to `data.url`. After checkout, Stripe sends the user to FRONTEND_URL/billing/success?session_id=cs_...\n\nChange `plan` to `explorer` or `premium` as needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.success && res?.data?.url) {",
                  "  pm.environment.set('checkoutUrl', res.data.url);",
                  "  pm.environment.set('checkoutSessionId', res.data.sessionId);",
                  "  console.log('Open this URL in your browser to complete checkout:', res.data.url);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"url\": \"https://checkout.stripe.com/pay/cs_test_...\",\n    \"sessionId\": \"cs_test_a1b2c3...\"\n  }\n}"
            },
            {
              "name": "400 Bad Request — invalid plan",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid enum value. Expected 'explorer' | 'pro' | 'premium', received 'trial'\",\n  \"statusCode\": 400\n}"
            },
            {
              "name": "503 — price ID not configured",
              "status": "Service Unavailable",
              "code": 503,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Stripe price ID for plan \\\"pro\\\" is not configured.\",\n  \"statusCode\": 503\n}"
            }
          ]

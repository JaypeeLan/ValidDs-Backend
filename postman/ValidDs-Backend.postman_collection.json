    {
      "name": "Products",
      "item": [
        {
          "name": "Product Feed",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=20&sortBy=trendScore",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1", "description": "Page number for pagination." },
                { "key": "limit", "value": "20", "description": "Number of results per page." },
                { "key": "sortBy", "value": "trendScore", "description": "Sorting criteria: 'trendScore', 'views', 'recent', or 'engagement'" }
              ]
            },
            "description": "Fetches a paginated, filterable feed of trending dropshipping products. The response region is automatically detected based on the authenticated user's profile locale."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"products\": [],\n    \"pagination\": {\"total\": 10, \"page\": 1, \"limit\": 20},\n    \"freshness\": {\"product\": \"2023-01-01T00:00:00.000Z\"},\n    \"region\": \"US\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/search?q=dropship&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "search"],
              "query": [
                { "key": "q", "value": "dropship", "description": "Text query to search for across titles, descriptions, and hashtags." },
                { "key": "page", "value": "1" }
              ]
            },
            "description": "Performs a full-text search against the product database to find relevant items matching a specific keyword or niche."
          },
          "response": [
             {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"products\": [],\n    \"pagination\": {\"total\": 5, \"page\": 1, \"limit\": 20}\n  }\n}"
            }
          ]
        },
